# استخدام نسخة Node.js مستقرة كقاعدة بناء
FROM node:20-slim

# تعيين مجلد العمل داخل الحاوية
WORKDIR /app

# نسخ ملفات الحزم لتثبيتها
COPY package*.json ./

# تثبيت الحزم المطلوبة للتشغيل والبناء
RUN npm install

# نسخ بقية ملفات المشروع إلى داخل الحاوية
COPY . .

# بناء الواجهة الأمامية وتجميع خادم السيرفر لبيئة الإنتاج
RUN npm run build

# إعلام الحاوية بالمنفذ المستخدم
EXPOSE 7860

# تعيين المنفذ كمتغير بيئة داخل السيرفر
ENV PORT=7860
ENV NODE_ENV=production

# أمر تشغيل الخادم الخلفي للتطبيق
CMD ["npm", "start"]
