# استخدام نسخة دبيان المخففة مع Node.js 22 لتوافق تجميع تيلويند v4 المكتوب بالرست
FROM node:22-slim

# تعيين مجلد العمل
WORKDIR /app

# نسخ ملفات الحزم لتثبيتها
COPY package*.json ./

# تثبيت الحزم المطلوبة للتشغيل والبناء
RUN npm install

# نسخ بقية ملفات المشروع
COPY . .

# بناء الواجهة الأمامية وتجميع خادم السيرفر
RUN npm run build

# إعلام الحاوية بالمنفذ المستخدم لربطه بالمنصة
EXPOSE 3000

# تعيين المنفذ كمتغير بيئة داخل السيرفر
ENV PORT=3000
ENV NODE_ENV=production

# أمر تشغيل الخادم الخلفي للتطبيق
CMD ["npm", "start"]
